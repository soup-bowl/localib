// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/universal
{
  "name": "Localib Dev",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/base:jammy",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true"
    }
  },
  "forwardPorts": [8100, 5132, 8080],
  "postCreateCommand": "./.devcontainer/postCreateCommand.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "ms-azuretools.vscode-docker",
        "WebNative.webnative",
        "mgmcdermott.vscode-language-babel",
        "humao.rest-client",
        "ms-dotnettools.csdevkit"
      ]
    }
  },
  // Add these as Codespaces secrets on the repository (Settings > Secrets and variables > Codespaces)
  // and they are injected automatically. Everything else is worked out in localib-env.sh.
  "secrets": {
    "LOCALIB_DISCOGS_CONSUMER_KEY": {
      "description": "Consumer Key from your Discogs developer application.",
      "documentationUrl": "https://www.discogs.com/settings/developers"
    },
    "LOCALIB_DISCOGS_CONSUMER_SECRET": {
      "description": "Consumer Secret from your Discogs developer application.",
      "documentationUrl": "https://www.discogs.com/settings/developers"
    }
  },
  // Pick up the variables exported by shell profiles (localib-env.sh), including for debug launches.
  "userEnvProbe": "loginInteractiveShell",
  "portsAttributes": {
    "8080": {
      "label": "pma"
    },
    "5132": {
      "label": "API"
    },
    "8100": {
      "label": "Web"
    }
  }
}
