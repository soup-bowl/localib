{
	"name": "localib",
	"description": "Collects your Discogs library for offline usage",
	"private": true,
	"version": "develop",
	"type": "module",
	"scripts": {
		"start": "npm run serve",
		"dev": "vite",
		"build": "tsc && vite build",
		"build:ion": "tsc && ionic build --prod",
		"serve": "ionic serve --host=0.0.0.0",
		"preview": "vite preview",
		"test.unit": "vitest",
		"test.unit:run": "vitest run",
		"lint": "eslint",
		"format": "prettier . --write"
	},
	"dependencies": {
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "^8.5.3",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/keyboard": "^8.0.6",
		"@capacitor/status-bar": "^8.0.4",
		"@ionic/react": "^9.0.8",
		"@ionic/react-router": "^9.0.8",
		"@rdlabo/ionic-theme-ios26": "9.4.1",
		"@tanstack/query-sync-storage-persister": "^5.104.3",
		"@tanstack/react-query": "^5.104.3",
		"@tanstack/react-query-persist-client": "^5.104.3",
		"idb-keyval": "^6.3.0",
		"ionicons": "^8.1.0",
		"qrcode.react": "^4.2.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^6.30.3",
		"react-router-dom": "^6.30.3"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.3",
		"@eslint/js": "^9.39.5",
		"@ionic/cli": "^7.2.1",
		"@tanstack/eslint-plugin-query": "^5.104.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-legacy": "^8.2.3",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"globals": "^17.13.0",
		"jsdom": "^30.1.2",
		"prettier": "^3.9.10",
		"react-barcode-scanner": "^4.1.0",
		"terser": "^5.51.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.5"
	}
}
