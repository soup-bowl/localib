ARG DOTNET_VERSION=10.0
ARG BASE_VARIANT=noble

FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}-${BASE_VARIANT} AS build
ARG TARGETARCH

WORKDIR /src
COPY Discapp.Worker/*.csproj Discapp.Worker/
COPY Discapp.Shared/*.csproj Discapp.Shared/

RUN dotnet restore "Discapp.Worker/Discapp.Worker.csproj" -a "$TARGETARCH"
COPY . .
RUN dotnet publish "Discapp.Worker/Discapp.Worker.csproj" -a "$TARGETARCH" -c Release -o /publish

FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION}-${BASE_VARIANT} AS runtime

RUN set -eux; \
    if command -v apk >/dev/null 2>&1; then \
        apk add --no-cache krb5-libs su-exec; \
    else \
        apt-get update; \
        apt-get install -y --no-install-recommends libgssapi-krb5-2; \
        rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /app
COPY --from=build /publish /app

# UID/GID 1000 matches the first user on most Linux hosts, so files written to
# a bind-mounted image directory stay owned by that user. Override at runtime
# with PUID/PGID. Ubuntu images ship an "ubuntu" user on 1000, so remove it.
ARG APP_UID=1000
ARG APP_GID=1000

RUN set -eux; \
    if command -v apk >/dev/null 2>&1; then \
        addgroup -S -g "$APP_GID" discapp; \
        adduser  -S -D -u "$APP_UID" -G discapp -s /sbin/nologin discapp; \
    else \
        if id ubuntu >/dev/null 2>&1; then userdel --remove ubuntu; fi; \
        if getent group ubuntu >/dev/null; then groupdel ubuntu; fi; \
        groupadd --gid "$APP_GID" discapp; \
        useradd  --uid "$APP_UID" --gid discapp --create-home --shell /usr/sbin/nologin discapp; \
    fi; \
    mkdir -p /Images; \
    chown -R discapp:discapp /app /Images

COPY --chmod=755 docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# The container starts as root so the entrypoint can fix ownership of the
# image volume (bind mounts keep host ownership), then drops to discapp.
ENV LOCALIB_IMAGE_PATH=/Images
VOLUME ["${LOCALIB_IMAGE_PATH}"]

ENTRYPOINT ["docker-entrypoint.sh"]

CMD ["dotnet", "Discapp.Worker.dll"]
